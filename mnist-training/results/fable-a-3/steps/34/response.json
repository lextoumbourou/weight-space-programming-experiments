ws 0 and 3 measured)\n        [[0.2, 3.4, 15.6, 2.2], [N, N, N, N], [N, N, N, N], [1.4, 25.5, 20, 0.5]],       # 0\n        [[0, 0.1, 0.1, 0], [N, N, N, N], [N, N, N, N], [0.4, 0.9, 0.8, 0.1]],            # 1\n        [[2.2, 15.6, 8.9, 0.4], [N, N, N, N], [N, N, N, N], [8.2, 31.1, 26.5, 19.9]],    # 2\n        [[5.9, 37, 22.1, 1.2], [N, N, N, N], [N, N, N, N], [6, 25.3, 11.7, 0.2]],        # 3\n        [[0, 0, 0.1, 0], [N, N, N, N], [N, N, N, N], [0.2, 2.4, 0.5, 0.2]],              # 4\n        [[0.5, 12.3, 44, 40.2], [N, N, N, N], [N, N, N, N], [5.9, 29.8, 9.3, 0.7]],      # 5\n        [[0, 0, 0.3, 0.1], [N, N, N, N], [N, N, N, N], [0.1, 10.3, 29.9, 1.3]],          # 6\n        [[12.4, 43.4, 28.3, 1.7], [N, N, N, N], [N, N, N, N], [0, 0.2, 0.2, 0.3]],       # 7\n        [[0.5, 8.1, 23.7, 5.6], [N, N, N, N], [N, N, N, N], [0.5, 4.6, 3.2, 0.6]],       # 8\n        [[0, 10, 24.1, 0.9], [N, N, N, N], [N, N, N, N], [0.1, 2.2, 0.1, 0]],            # 9\n    ]\n    heavy_tables = {0: HH_tab, 2: HV_tab}\n\n    class_counts = np.array([991, 1064, 990, 1030, 983, 915, 967, 1090, 1009, 961], dtype=float)\n\n    # ------------------------------------------------------------------\n    # Measured stroke-end statistics.  For every group: the list of categories\n    # (each a list of (channel, row, col) cells sharing one weight) and, per digit,\n    # the counts [no end, strongest end in category 1, category 2, ...].\n    # ------------------------------------------------------------------\n    UP, DN, LF, RT = 12, 13, 14, 15\n    end_groups = []\n\n    # up-ends, top-right cells (step 21)\n    end_groups.append((\n        [[(UP, 0, 2)], [(UP, 0, 3)], [(UP, 1, 2)], [(UP, 1, 3)]],\n        [[962, 11, 17, 0, 1], [495, 411, 158, 0, 0], [980, 2, 6, 1, 1], [1012, 8, 9, 1, 0],\n         [281, 185, 459, 18, 40], [888, 17, 10, 0, 0], [954, 3, 0, 0, 10], [937, 23, 120, 0, 10],\n         [935, 20, 38, 5, 11], [904, 12, 19, 3, 23]]))\n\n    # up-ends, top-left cells (step 25)\n    end_groups
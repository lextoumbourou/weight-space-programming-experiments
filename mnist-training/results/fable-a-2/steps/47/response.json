\n        # vertical energy, row 1, centre\n        (2, (1,), (1, 2), [0.561, 1.304, 0.68, 0.677, 1.02, 0.676, 0.916, 0.725, 0.996, 0.916], 0.35, 0.7),\n        # vertical energy, row 2, centre\n        (2, (2,), (1, 2), [0.452, 1.40, 0.624, 0.604, 0.981, 0.72, 0.915, 0.922, 1.153, 0.988], 0.35, 0.7),\n        # \"\\\" energy, row 1, centre\n        (3, (1,), (1, 2), [0.236, 0.173, 0.322, 0.845, 0.408, 0.85, 0.566, 0.491, 1.02, 0.759], 0.35, 0.7),\n        # \"\\\" energy, row 2, centre\n        (3, (2,), (1, 2), [0.131, 0.108, 0.543, 0.895, 0.83, 0.978, 0.823, 0.103, 0.973, 0.776], 0.35, 0.7),\n        # \"/\" energy, row 2, centre\n        (1, (2,), (1, 2), [0.794, 0.996, 1.368, 0.762, 0.94, 0.523, 1.152, 1.048, 1.42, 1.038], 0.40, 0.7),\n    ]\n\n    # ------------------------------------------------------------------\n    # fc: stroke templates + loci log-odds table + calibrated stroke-energy terms\n    # ------------------------------------------------------------------\n    ALPHA = 5.0       # scale of the stroke-template match\n    GAMMA = 0.6       # tempering of the loci log-odds (features are correlated)\n    GLINE = 0.6       # tempering of the stroke-energy terms\n    NTYP = 1.6        # typical number of saturated cells when a loci feature is present\n    SCALE = 0.44      # global confidence scale applied to all logits (fitted optimum)\n    # class offsets (in units of scale 0.40), scaled along with the logits\n    class_bias = np.array([0.66, 0.05, -0.03, -0.60, 1.17, -0.53, -0.36, 1.12, -1.15, -0.23])\n    class_bias = class_bias * (SCALE / 0.40)\n    fc_w = np.zeros((10, 256), dtype=np.float64)\n    fc_b = np.zeros(10, dtype=np.float64)\n\n    for d in range(10):\n        P = raw(digits[d])\n        ext = max(P[:, 0].max() - P[:, 0].min(), P[:, 1].max() - P[:, 1].min())\n        sc = BOX / ext\n        cx = (P[:, 0] * P[:, 3]).sum() / P[:, 3].sum()\n        cy = (P[:, 1] * P[:, 3]).sum() / P[:, 3].sum()\n        T = deposit((P[:, 0] - cx) * sc + 13.